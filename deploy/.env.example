# Claude Code clients send this as ANTHROPIC_AUTH_TOKEN.
CCPOOL_POOL_KEY=change-me
# For the MCP endpoint and admin API (policy, drain, pin). Defaults to the pool key if empty.
CCPOOL_ADMIN_KEY=change-me-admin
# Shared only between the router and the holders.
CCPOOL_INTERNAL_KEY=change-me-internal

# Paid fallbacks (only the ones you run)
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LITELLM_URL=http://litellm:4000
LITELLM_API_KEY=
